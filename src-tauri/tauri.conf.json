{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PandaSpy",
  "identifier": "io.github.seancallan.pandaspy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PandaSpy",
        "width": 420,
        "height": 560,
        "minWidth": 320,
        "minHeight": 360,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Monitor Bambu Lab 3D printers from the menu bar.",
    "longDescription": "PandaSpy watches Bambu Lab 3D printers on your local network and shows print progress, temperatures and errors from the menu bar, without a cloud round-trip.",
    "copyright": "Copyright © 2026 Sean Callan",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/doomspork/PandaSpy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IFBMQUNFSE9MREVSIG1pbmlzaWduIGtleSAtLSBUT0RPKHNpZ25pbmcpOiByZXBsYWNlIGJlZm9yZSBlbmFibGluZyB0aGUgdXBkYXRlciAoc2VlIENMQVVERS5tZCwgS25vd24gZ2FwczogVXBkYXRlciBpcyBvZmYpClJXUWZpM2ZHUkFZVnAwaUdJeG84SFdpQjR4eUdadzhTR29RTzkrdXN0ekdtUUpyMDFWM25FUTUwCg=="
    }
  }
}
